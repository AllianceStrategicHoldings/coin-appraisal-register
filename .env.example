# ============================================================================
#  Coin Appraisal Register — Integration Secrets template (SERVER / Make.com)
# ----------------------------------------------------------------------------
#  Copy to .env and fill in real values. Do NOT prefix with VITE_ or use in
#  web/ frontend code — these are backend credentials only.
#  Real .env is gitignored; this template is safe to commit.
# ============================================================================

# Greysheet / CDN (Dealer+ wholesale pricing) — Section 2.3
GREYSHEET_API_KEY=

# PCGS CoinFacts (cert authentication) — Section 2.3
PCGS_ACCESS_TOKEN=

# Apify (eBay sold-listings comps actor) — Section 2.3
APIFY_API_TOKEN=

# Cloudflare R2 (S3-compatible object storage) — Section 2.12
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=
R2_ACCOUNT_ID=

# Metals-API (live spot prices) — Section 2.3
METALS_API_KEY=

# Supabase (primary database)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
