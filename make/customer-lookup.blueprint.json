{
  "name": "customer-lookup",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": null,
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        },
        "restore": {
          "parameters": {
            "hook": {
              "data": {
                "editable": "true"
              },
              "label": "customer_lookup"
            }
          }
        },
        "parameters": [
          {
            "name": "hook",
            "type": "hook:gateway-webhook",
            "label": "Webhook",
            "required": true
          },
          {
            "name": "maxResults",
            "type": "number",
            "label": "Maximum number of results"
          }
        ]
      }
    },
    {
      "id": 2,
      "module": "util:SetVariables",
      "version": 1,
      "parameters": {},
      "mapper": {
        "scope": "roundtrip",
        "variables": [
          {
            "name": "supabase_service_key",
            "value": "REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        },
        "restore": {
          "expect": {
            "scope": {
              "label": "One cycle"
            },
            "variables": {
              "items": [
                null
              ]
            }
          }
        }
      }
    },
    {
      "id": 3,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": true,
        "useNewZLibDeCompress": true
      },
      "mapper": {
        "ca": "",
        "qs": [],
        "url": "https://jsklabrbirsidlnxpgmw.supabase.co/rest/v1/customer_master?phone=eq.{{1.phone}}&dob=eq.{{1.dob}}&select=id,name,zip,dl_number,tcpa_opt_in,deal_log(deal_number,accepted_at,total_actual_offer,status)",
        "gzip": true,
        "method": "get",
        "headers": [
          {
            "name": "apikey",
            "value": "{{2.supabase_service_key}}"
          },
          {
            "name": "Authorization",
            "value": "Bearer {{2.supabase_service_key}}"
          }
        ],
        "timeout": "",
        "useMtls": false,
        "authPass": "",
        "authUser": "",
        "bodyType": "",
        "serializeUrl": false,
        "shareCookies": false,
        "parseResponse": true,
        "followRedirect": true,
        "useQuerystring": false,
        "followAllRedirects": false,
        "rejectUnauthorized": true
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        },
        "restore": {
          "expect": {
            "qs": {
              "mode": "chose"
            },
            "method": {
              "mode": "chose",
              "label": "GET"
            },
            "headers": {
              "mode": "chose"
            },
            "bodyType": {
              "label": "Empty"
            }
          }
        }
      }
    },
    {
      "id": 4,
      "module": "gateway:WebhookRespond",
      "version": 1,
      "parameters": {},
      "mapper": {
        "body": "{\"found\":\"{{length(3.data)}}\",\"id\":\"{{get(map(3.data; \"id\"); 1)}}\",\"name\":\"{{get(map(3.data; \"name\"); 1)}}\",\"zip\":\"{{get(map(3.data; \"zip\"); 1)}}\",\"dl_number\":\"{{get(map(3.data; \"dl_number\"); 1)}}\",\"tcpa_opt_in\":\"{{get(map(3.data; \"tcpa_opt_in\"); 1)}}\",\"deal_numbers\":\"{{join(map(get(map(3.data; \"deal_log\"); 1); \"deal_number\"); \",\")}}\",\"deal_dates\":\"{{join(map(get(map(3.data; \"deal_log\"); 1); \"accepted_at\"); \",\")}}\",\"deal_totals\":\"{{join(map(get(map(3.data; \"deal_log\"); 1); \"total_actual_offer\"); \",\")}}\",\"deal_statuses\":\"{{join(map(get(map(3.data; \"deal_log\"); 1); \"status\"); \",\")}}\"}",
        "status": "200",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        },
        "restore": {
          "expect": {
            "headers": {
              "mode": "chose",
              "items": [
                null
              ]
            }
          }
        }
      }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "slots": null,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    }
  }
}